<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.frame.me</groupId>
        <artifactId>frame-me-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>frame-me-starter-cloud</artifactId>
    <name>frame-me-starter-cloud</name>
    <description>微服务云基础底座 Starter：Spring Cloud 配置刷新体系（@RefreshScope / RefreshEvent）+ 配置中心无关的刷新解密 + 注册中心无关的优雅下线编排</description>

    <dependencies>
        <!-- 云基础底座：两个平级独立 jar 都显式声明（Spring Cloud 2025.x 中 commons 不传递 context）。 -->
        <!-- - spring-cloud-context：配置刷新体系 @RefreshScope / RefreshEvent / EnvironmentChangeEvent / ContextRefresher（刷新解密监听器依赖） -->
        <!-- - spring-cloud-commons：serviceregistry 子包的 ServiceRegistry / Registration / AbstractAutoServiceRegistration（优雅下线反注册依赖） -->
        <!-- 版本由根 pom 的 spring-cloud-dependencies BOM 管控。 -->
        <!-- actuator：@Endpoint / HealthIndicator（优雅下线编排依赖）。web 无关，Servlet/WebFlux 双栈通用。 -->
        <!-- 不依赖 frame-me-starter-base：本模块代码不使用 base 能力，且 base 带 spring-boot-starter-web（Servlet 栈）， -->
        <!-- 会使 WebFlux 消费方（如 frame-me-gateway）被拖入 MVC 与 SC Gateway WebFlux 冲突。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-commons</artifactId>
        </dependency>
        <!-- 刷新解密能力：optional，消费方同时引入 sensi-encrypt 且配主密码时才装配刷新解密监听器 -->
        <dependency>
            <groupId>com.frame.me</groupId>
            <artifactId>frame-me-starter-sensi-encrypt</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
